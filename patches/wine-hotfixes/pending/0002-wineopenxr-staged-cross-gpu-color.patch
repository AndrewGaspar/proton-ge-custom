+static uint64_t timestamp_delta(uint64_t start, uint64_t end, uint32_t valid_bits) {
+  if (!valid_bits || valid_bits >= 64)
+    return end - start;
+  return (end - start) & ((1ull << valid_bits) - 1);
+}
